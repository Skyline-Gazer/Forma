{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.local/schemas/manifest-1.0.schema.json",
  "title": "Forma Manifest 1.0",
  "description": "The program-produced artifact. Identity fields are UUIDs or 64-hex digests that only Forma writes, and grants_execution is a constant false: no serialized manifest may claim execution authority. A manifest that fails this schema cannot be stored or exported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope", "entries", "validation_report"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "envelope": {"$ref": "#/$defs/envelope"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 200000, "items": {"$ref": "#/$defs/entry"}},
    "validation_report": {"$ref": "#/$defs/report"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "fieldIdentifier": {
      "enum": [
        "projectname", "completionyear", "bidderentity", "department", "salesowner",
        "endcustomer", "biddeadline", "tenderreference", "bsdcode",
        "documentcategory", "documenttype", "issuer"
      ]
    },
    "nullableText": {"type": ["string", "null"], "maxLength": 512},
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id", "revision", "supersedes_revision", "scope_id", "source_root_id",
        "profile_id", "profile_version", "schema_version", "case_pack_id", "case_pack_version",
        "model_provider", "model_id", "context_revision", "prompt_version", "extractor_version",
        "redaction_version", "input_digest", "context_digest", "created_at", "state", "grants_execution"
      ],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "supersedes_revision": {"type": ["integer", "null"], "minimum": 1},
        "scope_id": {"$ref": "#/$defs/uuid"},
        "source_root_id": {"$ref": "#/$defs/uuid"},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "schema_version": {"const": "1.0"},
        "case_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "case_pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "model_provider": {"enum": ["openai", "anthropic", "local", "none"]},
        "model_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "context_revision": {"type": "integer", "minimum": 1},
        "prompt_version": {"type": "string", "pattern": "^[a-z0-9.-]{1,64}$"},
        "extractor_version": {"type": "string", "pattern": "^[a-z0-9.-]{1,64}$"},
        "redaction_version": {"type": ["string", "null"], "pattern": "^[a-z0-9.-]{1,64}$"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "state": {"enum": ["draft", "validated", "partially_validated", "invalidated"]},
        "grants_execution": {"const": false}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "snapshot_fingerprint", "snapshot_revision", "source_version",
        "relative_path", "state", "target", "metadata", "fields", "associations",
        "eligible_for_auto_execution", "invalidated_reason", "confidence"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/uuid"},
        "snapshot_fingerprint": {"$ref": "#/$defs/digest"},
        "snapshot_revision": {"type": "integer", "minimum": 1},
        "source_version": {"type": "integer", "minimum": 1},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^/\\\\].*$"},
        "state": {"enum": ["unknown", "hold", "mapped", "validated", "invalidated"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database_name", "group_path", "resolved"],
          "properties": {
            "database_name": {"type": ["string", "null"], "maxLength": 128},
            "group_path": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
            "resolved": {"type": "boolean"}
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectname", "completionyear", "bidderentity", "department", "salesowner",
            "endcustomer", "biddeadline", "tenderreference", "bsdcode",
            "documentcategory", "documenttype", "issuer"
          ],
          "properties": {
            "projectname": {"$ref": "#/$defs/nullableText"},
            "completionyear": {"type": ["string", "null"], "pattern": "^[0-9]{4}$"},
            "bidderentity": {"$ref": "#/$defs/nullableText"},
            "department": {"$ref": "#/$defs/nullableText"},
            "salesowner": {"$ref": "#/$defs/nullableText"},
            "endcustomer": {"$ref": "#/$defs/nullableText"},
            "biddeadline": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "tenderreference": {"$ref": "#/$defs/nullableText"},
            "bsdcode": {"$ref": "#/$defs/nullableText"},
            "documentcategory": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
            "documenttype": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
            "issuer": {"$ref": "#/$defs/nullableText"}
          }
        },
        "fields": {
          "type": "array", "minItems": 12, "maxItems": 12,
          "items": {"$ref": "#/$defs/fieldOutcome"}
        },
        "associations": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_id", "basis", "evidence_ids"],
            "properties": {
              "kind": {"enum": ["project_candidate", "sibling", "duplicate_content", "history_reference"]},
              "source_id": {"$ref": "#/$defs/uuid"},
              "basis": {"type": "string", "minLength": 4, "maxLength": 300},
              "evidence_ids": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/ref"}}
            }
          }
        },
        "eligible_for_auto_execution": {"type": "boolean"},
        "invalidated_reason": {"type": ["string", "null"], "minLength": 4, "maxLength": 300},
        "confidence": {"type": ["string", "null"], "enum": ["low", "medium", "high", null]},
        "provider_reasoning": {"type": ["string", "null"], "maxLength": 600}
      }
    },
    "fieldOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "status", "evidence_ids", "conflicts"],
      "properties": {
        "field": {"$ref": "#/$defs/fieldIdentifier"},
        "value": {"type": ["string", "null"], "maxLength": 512},
        "status": {"enum": ["evidenced", "inherited", "unknown", "conflict", "rejected_by_policy", "not_applicable"]},
        "evidence_ids": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/ref"}},
        "conflicts": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 4, "maxLength": 300}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "counts"],
      "properties": {
        "groups": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "status", "violations"],
            "properties": {
              "group": {"enum": ["schema", "evidence", "profile_policy", "snapshot", "association", "eligibility"]},
              "status": {"enum": ["passed", "failed", "blocked"]},
              "violations": {
                "type": "array", "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "instance_path", "detail"],
                  "properties": {
                    "code": {"type": "string", "pattern": "^[a-z0-9_]{3,64}$"},
                    "instance_path": {"type": "string", "maxLength": 512},
                    "detail": {"type": "string", "maxLength": 300}
                  }
                }
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entries", "validated", "hold", "unknown", "invalidated", "eligible"],
          "properties": {
            "entries": {"type": "integer", "minimum": 0},
            "validated": {"type": "integer", "minimum": 0},
            "hold": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0},
            "invalidated": {"type": "integer", "minimum": 0},
            "eligible": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
