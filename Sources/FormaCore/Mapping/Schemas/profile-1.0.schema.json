{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.local/schemas/profile-1.0.schema.json",
  "title": "Forma Mapping Profile 1.0",
  "description": "A closed Mapping Profile. Object schemas always set additionalProperties false, and every string check uses pattern rather than format: Draft 2020-12 treats format as an annotation unless format assertion is explicitly enabled, so relying on it would leave a silently disabled rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "profile_version", "display_name", "target",
    "permits_unaffiliated_documents", "grants_execution", "categories",
    "document_types", "case_pack", "counter_examples", "fields"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "target": {"$ref": "#/$defs/target"},
    "permits_unaffiliated_documents": {"type": "boolean"},
    "grants_execution": {"const": false},
    "categories": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/category"}},
    "document_types": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/documentType"}},
    "case_pack": {"$ref": "#/$defs/casePack"},
    "counter_examples": {
      "type": "array", "minItems": 4, "maxItems": 16,
      "items": {"type": "string", "minLength": 8, "maxLength": 300}
    },
    "fields": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/field"}}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "database_name", "database_uuid", "group_template", "note"],
      "properties": {
        "kind": {"enum": ["symbolic", "live"]},
        "database_name": {"type": ["string", "null"], "maxLength": 128},
        "database_uuid": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
        "group_template": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/\\\\]+$"}
        },
        "note": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "meaning"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 64},
        "meaning": {"type": "string", "minLength": 8, "maxLength": 300}
      }
    },
    "documentType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "clues"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 64},
        "clues": {
          "type": "array", "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 48}
        }
      }
    },
    "casePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier", "level", "value_type", "required_for_validated", "nullable",
        "allowed_evidence_sources", "insufficient_evidence_sources", "rule", "native_type_status"
      ],
      "properties": {
        "identifier": {
          "enum": [
            "projectname", "completionyear", "bidderentity", "department", "salesowner",
            "endcustomer", "biddeadline", "tenderreference", "bsdcode",
            "documentcategory", "documenttype", "issuer"
          ]
        },
        "level": {"enum": ["project", "document"]},
        "value_type": {"enum": ["text", "year", "date_text", "category", "document_type"]},
        "required_for_validated": {"type": "boolean"},
        "nullable": {"type": "boolean"},
        "allowed_evidence_sources": {
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["filename", "path", "content", "sibling", "fs_metadata", "mcp"]}
        },
        "insufficient_evidence_sources": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["filename", "path", "content", "sibling", "fs_metadata", "mcp"]}
        },
        "rule": {"type": "string", "minLength": 8, "maxLength": 600},
        "native_type_status": {"const": "unverified"}
      }
    }
  }
}
