{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.local/schemas/gold-record-1.0.schema.json",
  "title": "Forma Gold Record 1.0",
  "description": "One independently annotated reference answer used to measure mapping quality - never a prompt example. Real business material must not be committed: a record is either synthetic, or redacted and reviewed by a role code. `review.status` decides whether the record counts in a metric denominator; `adjudication_pending` records are reported as excluded volume, never silently dropped. `usage` keeps the evaluation set disjoint from the few-shot pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "dataset_revision", "profiles", "scenario",
    "source", "expected", "citations", "annotation", "review", "usage"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"$ref": "#/$defs/ref"},
    "dataset_revision": {"$ref": "#/$defs/revision"},
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["project-archive", "vendor-library"]}
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "description"],
      "properties": {
        "category": {
          "enum": [
            "positive", "negative", "conflict", "refusal",
            "near_duplicate", "template_family", "partial_evidence", "adversarial_wording"
          ]
        },
        "description": {"type": "string", "minLength": 8, "maxLength": 200}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_cluster_key", "redacted_relative_path", "redacted_filename"],
      "properties": {
        "project_cluster_key": {"$ref": "#/$defs/ref"},
        "source_uuid": {"$ref": "#/$defs/ref"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "redacted_relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "redacted_filename": {"type": "string", "minLength": 1, "maxLength": 255},
        "near_duplicate_group": {"$ref": "#/$defs/ref"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "project_reference", "target_category", "metadata"],
      "properties": {
        "state": {"enum": ["mapped", "validated", "hold", "unknown", "invalidated"]},
        "project_reference": {"type": ["string", "null"], "maxLength": 200},
        "target_category": {"type": ["string", "null"], "maxLength": 128},
        "target_type": {"type": ["string", "null"], "maxLength": 128},
        "metadata": {"$ref": "#/$defs/metadata"},
        "allowed_unknown_fields": {
          "type": "array", "maxItems": 12, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldIdentifier"}
        }
      }
    },
    "citations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "excerpt"],
        "properties": {
          "label": {"$ref": "#/$defs/ref"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 512},
          "locator": {"type": ["string", "null"], "maxLength": 256}
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotator_code", "annotated_on", "basis"],
      "properties": {
        "annotator_code": {"$ref": "#/$defs/roleCode"},
        "annotated_on": {"$ref": "#/$defs/date"},
        "basis": {"enum": ["verified_document_text", "verified_business_fact", "both"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "redaction", "reviewer_code", "reviewed_on"],
      "properties": {
        "status": {"enum": ["confirmed", "adjudication_pending", "rejected"]},
        "redaction": {"enum": ["synthetic", "reviewed", "unredacted"]},
        "reviewer_code": {"$ref": "#/$defs/roleCode"},
        "reviewed_on": {"$ref": "#/$defs/date"}
      }
    },
    "usage": {"enum": ["evaluation", "fewshot", "excluded"]}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "roleCode": {"type": "string", "pattern": "^[A-Z]{1,4}[0-9]{1,3}$"},
    "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "fieldIdentifier": {
      "enum": [
        "projectname", "completionyear", "bidderentity", "department", "salesowner",
        "endcustomer", "biddeadline", "tenderreference", "bsdcode",
        "documentcategory", "documenttype", "issuer"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectname", "completionyear", "bidderentity", "department", "salesowner",
        "endcustomer", "biddeadline", "tenderreference", "bsdcode",
        "documentcategory", "documenttype", "issuer"
      ],
      "properties": {
        "projectname": {"type": ["string", "null"], "maxLength": 512},
        "completionyear": {"type": ["string", "null"], "maxLength": 512},
        "bidderentity": {"type": ["string", "null"], "maxLength": 512},
        "department": {"type": ["string", "null"], "maxLength": 512},
        "salesowner": {"type": ["string", "null"], "maxLength": 512},
        "endcustomer": {"type": ["string", "null"], "maxLength": 512},
        "biddeadline": {"type": ["string", "null"], "maxLength": 512},
        "tenderreference": {"type": ["string", "null"], "maxLength": 512},
        "bsdcode": {"type": ["string", "null"], "maxLength": 512},
        "documentcategory": {"type": ["string", "null"], "maxLength": 512},
        "documenttype": {"type": ["string", "null"], "maxLength": 512},
        "issuer": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  }
}
