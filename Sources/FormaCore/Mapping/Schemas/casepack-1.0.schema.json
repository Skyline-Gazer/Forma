{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.local/schemas/casepack-1.0.schema.json",
  "title": "Forma CasePack 1.0",
  "description": "Few-shot cases sent to a provider. Every case must be marked synthetic or reviewed: an unreviewed model prediction may not become a reference answer, and real business material may not be committed. `reviewed_by` names a reviewer role, never a customer or an individual employee.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "cases": {"type": "array", "minItems": 20, "maxItems": 30, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "fieldIdentifier": {
      "enum": [
        "projectname", "completionyear", "bidderentity", "department", "salesowner",
        "endcustomer", "biddeadline", "tenderreference", "bsdcode",
        "documentcategory", "documenttype", "issuer"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "kind", "scenario", "profiles", "input", "expected",
        "why_not", "evidence_level", "source_version", "review"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/ref"},
        "kind": {"enum": ["positive", "negative", "conflict", "refusal"]},
        "scenario": {"type": "string", "minLength": 8, "maxLength": 200},
        "profiles": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["project-archive", "vendor-library"]}
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["redacted_relative_path", "redacted_filename", "context_summary", "citations"],
          "properties": {
            "redacted_relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
            "redacted_filename": {"type": "string", "minLength": 1, "maxLength": 256},
            "context_summary": {"type": ["string", "null"], "maxLength": 600},
            "citations": {
              "type": "array", "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "excerpt"],
                "properties": {
                  "label": {"type": "string", "minLength": 1, "maxLength": 64},
                  "excerpt": {"type": "string", "minLength": 1, "maxLength": 400}
                }
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "document_category", "document_type", "metadata"],
          "properties": {
            "state": {"enum": ["mapped", "hold", "unknown"]},
            "document_category": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
            "document_type": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projectname", "completionyear", "bidderentity", "department", "salesowner",
                "endcustomer", "biddeadline", "tenderreference", "bsdcode",
                "documentcategory", "documenttype", "issuer"
              ],
              "properties": {
                "projectname": {"type": ["string", "null"], "maxLength": 512},
                "completionyear": {"type": ["string", "null"], "pattern": "^[0-9]{4}$"},
                "bidderentity": {"type": ["string", "null"], "maxLength": 512},
                "department": {"type": ["string", "null"], "maxLength": 512},
                "salesowner": {"type": ["string", "null"], "maxLength": 512},
                "endcustomer": {"type": ["string", "null"], "maxLength": 512},
                "biddeadline": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                "tenderreference": {"type": ["string", "null"], "maxLength": 512},
                "bsdcode": {"type": ["string", "null"], "maxLength": 512},
                "documentcategory": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
                "documenttype": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
                "issuer": {"type": ["string", "null"], "maxLength": 512}
              }
            }
          }
        },
        "why_not": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {"type": "string", "minLength": 8, "maxLength": 300}
        },
        "evidence_level": {
          "enum": ["content_verified", "filename_path_only", "historical_label_only", "adjudication_pending"]
        },
        "source_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "redaction", "reviewer_role"],
          "properties": {
            "status": {"enum": ["accepted", "pending", "rejected"]},
            "redaction": {"enum": ["synthetic", "reviewed"]},
            "reviewer_role": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
          }
        }
      }
    }
  }
}
