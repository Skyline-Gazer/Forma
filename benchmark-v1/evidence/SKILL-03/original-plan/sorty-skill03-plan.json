    "\u9884\u89c8\u76ee\u6807\u6587\u4ef6\u540d\u4fdd\u7559\u539f\u6269\u5c55\u540d\uff1b\u5efa\u8bae\u72b6\u6001\u8bcd\u7528\u4e8e\u68c0\u7d22\uff0c\u5e94\u7528\u524d\u987b\u7531\u6d4b\u8bd5\u8005\u786e\u8ba4\u76ee\u6807\u8def\u5f84\u53ca\u53ef\u80fd\u7684\u91cd\u540d\u51b2\u7a81\u3002",
    "HC26-041 \u7684\u62a5\u4ef7\u8868\u62ab\u9732\u5185\u90e8\u91c7\u8d2d\u6210\u672c\uff0c\u5efa\u8bae\u5728\u4e1a\u52a1\u5143\u6570\u636e\u4e2d\u6807\u6ce8\u654f\u611f\u7ea7\u522b\u4e0e\u8bbf\u95ee\u8303\u56f4\u3002"
  ]
}
